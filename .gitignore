# KnowledgeMap root .gitignore

# ---- Python / Backend ----
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/
.env
*.env.local

# Alembic compiled
backend/alembic/versions/__pycache__/

# Python tool caches (added 2026-09-20)
# .pytest_cache/ was missing here: it made every `git status` emit a
# "Permission denied" warning instead of being silently ignored.
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# ---- Node / Frontend ----
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.local
frontend/*.local

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- IDE ----
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Misc ----
*.local
账单详情.txt
backend/*.db
# `backend/*.txt` was far too broad for what it was actually for: the single
# accidental artifact `conda activate desheng.txt` (31 B) created by a shell
# redirect. A blanket rule silently hides ANY future .txt in backend/ — e.g. a
# schema note — from `git status`. Narrowed 2026-09-20 to that one artifact.
# (backend/requirements.txt was never affected: tracked files ignore .gitignore.)
backend/conda activate*.txt

UI预览图/*
tmp_screenshots/*

# (removed 2026-09-20) stale rule `TradeSim/*` — no such directory exists in
# the repo since TradeSim was merged into the portal as a feature module.

# ---- DeepSeek Harness runtime ----
.deepseek-harness/
.dsh/
.npm-cache/
.pnpm-store/
*.tgz
