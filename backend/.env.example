# KnowledgeMap existing settings
# DATABASE_URL is currently configured in app/database.py.

# QWeather (KnowledgeMap weather card)
# Do not commit the real backend/.env file.
QWEATHER_API_HOST=your-api-host.qweatherapi.com
QWEATHER_API_KEY=your-api-key

# TradeSim relational and document storage
TRADESIM_MYSQL_URL=mysql+pymysql://root:root@127.0.0.1:3306/tradesim
TRADESIM_MONGO_URL=mongodb://127.0.0.1:27017
TRADESIM_MONGO_DB_NAME=tradesim
TRADESIM_MONGO_COLLECTION_LOGS=simulation_logs
TRADESIM_AUTO_CREATE_TABLES=1

# TradeSim AI analysis (optional)
TRADESIM_LLM_API_KEY=
TRADESIM_LLM_MODEL=qwen-max
TRADESIM_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
