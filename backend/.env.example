# QWeather (KnowledgeMap weather card)
QWEATHER_API_HOST=xxx
QWEATHER_API_KEY=xxx

# DeepSeek provider: keep all three settings together when using DeepSeek.
DEEPSEEK_API_KEY=xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI-compatible provider alternative.
OPENAI_API_KEY=xxx
OPENAI_BASE_URL=https://naiccc.com/v1
OPENAI_MODEL=gpt-5.6-terra

MySQL_USER=xxx
MySQL_PASSWORD=xxx
# Optional — defaults shown. Leave commented to use the defaults.
# MySQL_HOST=127.0.0.1
# MySQL_PORT=3306
# MySQL_DATABASE=knowledgemap
# A full connection string wins over every MySQL_* key above:
# DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/knowledgemap?charset=utf8mb4

# TradeSim shares the single `knowledgemap` MySQL database above (its
# simulation_records table lives there, see app.database). It only needs its
# own settings for MongoDB (large equity-curve/trade-log documents) and,
# optionally, an LLM key for the AI backtest analysis feature.
# TRADESIM_MONGO_URL=mongodb://127.0.0.1:27017
# TRADESIM_MONGO_DB_NAME=tradesim
# TRADESIM_LLM_API_KEY=xxx
# TRADESIM_LLM_BASE_URL=https://api.deepseek.com
# TRADESIM_LLM_MODEL=deepseek-chat